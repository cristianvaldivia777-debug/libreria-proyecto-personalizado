@model Prestamo
@{ ViewData["Title"] = "Nuevo préstamo"; }
<h2>Nuevo préstamo</h2>
<form asp-action="Create">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="LibroId" class="form-label"></label>
        <select asp-for="LibroId" asp-items="(SelectList)ViewBag.Libros" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="SocioId" class="form-label"></label>
        <select asp-for="SocioId" asp-items="(SelectList)ViewBag.Socios" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="FechaPrestamo" class="form-label"></label>
        <input asp-for="FechaPrestamo" type="date" class="form-control" />
    </div>
    <button class="btn btn-primary">Registrar</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">📚 Biblioteca</a>
        <div class="navbar-nav">
            <a class="nav-link" asp-controller="Libros" asp-action="Index">Libros</a>
            <a class="nav-link" asp-controller="Socios" asp-action="Index">Socios</a>
            <a class="nav-link" asp-controller="Prestamos" asp-action="Index">Préstamos</a>
        </div>
    </div>
</nav>
<main class="container">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</main>
</body>
</html>
